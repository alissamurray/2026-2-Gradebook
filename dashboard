<!DOCTYPE html>
<html>
<head>
    <title>Biology Grade Dashboard</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 50px; text-align: center; background-color: #f4f7f6; }
        .box { border: 1px solid #ccc; padding: 30px; border-radius: 10px; max-width: 400px; margin: auto; background: white; box-shadow: 0px 4px 10px rgba(0,0,0,0.1); }
        input { display: block; width: 90%; margin: 15px auto; padding: 10px; border: 1px solid #ddd; border-radius: 5px; }
        button { padding: 10px 20px; background: #28a745; color: white; border: none; border-radius: 5px; cursor: pointer; width: 95%; font-size: 16px;}
        button:hover { background: #218838; }
    </style>
</head>
<body>

    <div id="login-screen" class="box">
        <h2>Student Login</h2>
        <p>Enter your assigned email/username and password.</p>
        <input type="text" id="username" placeholder="Username / Email">
        <input type="password" id="password" placeholder="Password / PIN">
        <button onclick="login()">Login</button>
        <p id="message" style="color:red; margin-top: 15px;"></p>
    </div>

    <div id="dashboard-screen" class="box" style="display:none;">
        <h2>Welcome, <span id="student-name"></span>!</h2>
        <hr>
        <h3>Current Grade: <span id="student-grade"></span>%</h3>
        <h3>Cohort Rank: <span id="student-rank"></span></h3>
    </div>

    <script>
        // REPLACE THIS WITH YOUR DEPLOYED GOOGLE APPS SCRIPT WEB APP URL
        const API_URL = "https://script.google.com/macros/s/AKfycbxt0brfk2CuESz8RHj6F5ygeAp2-UyUpqQl6_vmkukhr5ALC3eW3CebmGIxHD9kjMsyBA/exec";

        async function login() {
            document.getElementById('message').innerText = "Logging you in...";
            const user = document.getElementById('username').value.trim();
            const pass = document.getElementById('password').value.trim();

            try {
                const response = await fetch(API_URL, {
                    method: 'POST',
                    body: JSON.stringify({ username: user, password: pass })
                });

                const result = await response.json();

                if (result.status === "success") {
                    // Hide login, show dashboard
                    document.getElementById('login-screen').style.display = 'none';
                    document.getElementById('dashboard-screen').style.display = 'block';
                    
                    // Fill in the data from Google Sheets
                    document.getElementById('student-name').innerText = result.data.name;
                    document.getElementById('student-grade').innerText = result.data.overallGrade;
                    document.getElementById('student-rank').innerText = result.data.cohortRank;
                } else {
                    document.getElementById('message').innerText = result.message;
                }
            } catch (error) {
                document.getElementById('message').innerText = "Error connecting to the grade database.";
                console.error(error);
            }
        }
    </script>
</body>
</html>
